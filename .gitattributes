# Normalise line endings: LF in the repository, native in the working tree.
# Without this, a Windows checkout reports every text file as modified.
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.csv   text eol=lf
*.sh    text eol=lf
*.ipynb text eol=lf

*.png   binary
*.pdf   binary
*.joblib binary
